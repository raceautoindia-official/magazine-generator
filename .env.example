# Copy to .env.local (development) or .env (server) and fill in. Never commit the filled file.

# Main site database (read only use)
NEWS_DB_HOST=localhost
NEWS_DB_PORT=3306
NEWS_DB_USER=
NEWS_DB_PASSWORD=
NEWS_DB_NAME=race_news

# Generator's own tables (all prefixed mg_). Uses the same host, user and password.
# If the database user cannot create a database, set this to race_news.
APP_DB_NAME=magazine_generator

# Random string, at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public base URL of the S3 bucket that holds post images (with trailing slash)
S3_PUBLIC_BASE_URL=https://raceautonextjs-backup.s3.ap-south-1.amazonaws.com/

# AI providers (used from phase 4 on)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where backups are written by "npm run backup" (default ./backups). Put it on another disk if there is one.
# BACKUP_DIR=/var/backups/magazine-generator
# How many nightly database dumps to keep (default 14)
# BACKUP_KEEP=14

# Where generated PDFs and cached images are stored
DATA_DIR=./data
