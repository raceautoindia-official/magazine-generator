# /etc/nginx/sites-available/magazine.raceautoindia.com
# After enabling: sudo certbot --nginx -d magazine.raceautoindia.com

server {
    listen 80;
    server_name magazine.raceautoindia.com;

    client_max_body_size 32m;   # advert uploads are up to 30 MB

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        # Server actions compare Origin with these; they must be forwarded unchanged.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Long work (generating, creating a PDF) runs in the background and answers at once, so no request needs
        # long; this covers a large advert upload on a slow line.
        proxy_read_timeout 120s;
    }
}
